#!/bin/sh
# alabofur - simple bandwidth shaper with ufw-like UX
#
# Copyright (c) 2026 Tuncay Bahadır <tuncaybahadir@protonmail.com>
# License: MIT

set -u

PROG="alabofur"
VERSION="1.1.0"
SERVICE_INSTALL_PATH="/etc/systemd/system/alabofur.service"

# ---------------------------------------------------------------------------
# Locate library + data dirs. Works both from a source checkout (bin/, lib/,
# share/ siblings) and once installed (/usr/bin, /usr/lib, /usr/share), since
# <bindir>/../lib resolves to /usr/lib for an installed /usr/bin/alabofur.
# Overridable via ALABOFUR_LIBDIR / ALABOFUR_SHAREDIR for packaging tests.
# ---------------------------------------------------------------------------
_self=$(readlink -f "$0" 2>/dev/null || echo "$0")
_selfdir=$(dirname "$_self")

: "${ALABOFUR_LIBDIR:=}"
if [ -z "$ALABOFUR_LIBDIR" ]; then
    if [ -f "$_selfdir/../lib/alabofur/tc" ]; then
        ALABOFUR_LIBDIR="$_selfdir/../lib/alabofur"
    else
        ALABOFUR_LIBDIR="/usr/lib/alabofur"
    fi
fi

: "${ALABOFUR_SHAREDIR:=}"
if [ -z "$ALABOFUR_SHAREDIR" ]; then
    if [ -f "$_selfdir/../share/alabofur/alabofur.service" ]; then
        ALABOFUR_SHAREDIR="$_selfdir/../share/alabofur"
    else
        ALABOFUR_SHAREDIR="/usr/share/alabofur"
    fi
fi

# shellcheck source=lib/alabofur/common
. "$ALABOFUR_LIBDIR/common"
# shellcheck source=lib/alabofur/config
. "$ALABOFUR_LIBDIR/config"
# shellcheck source=lib/alabofur/tc
. "$ALABOFUR_LIBDIR/tc"
# shellcheck source=lib/alabofur/stats
. "$ALABOFUR_LIBDIR/stats"

TAB=$(printf '\t')

# ---------------------------------------------------------------------------
# config-driven apply
# ---------------------------------------------------------------------------

# apply_interfaces [IFACE...]
# Apply shaping for the given interfaces, or all configured ones when none
# are given. Errors if a requested interface is not in the config.
apply_interfaces() {
    _configs=$(load_all_configs) || return 1

    if [ "$#" -gt 0 ]; then
        _missing=
        for _iface in "$@"; do
            if ! printf '%s\n' "$_configs" | awk -F "$TAB" -v w="$_iface" '$1==w{f=1} END{exit(f?0:1)}'; then
                _missing="$_missing $_iface"
            fi
        done
        if [ -n "$_missing" ]; then
            err "Interfaces not in config:$_missing"
            return 1
        fi
    fi

    _rc=0
    printf '%s\n' "$_configs" | {
        while IFS="$TAB" read -r iface dl ul ipv6; do
            [ -n "$iface" ] || continue
            if [ "$#" -gt 0 ]; then
                _match=0
                for _want in "$@"; do
                    [ "$_want" = "$iface" ] && _match=1
                done
                [ "$_match" -eq 1 ] || continue
            fi
            tc_setup "$iface" "$dl" "$ul" "$ipv6"
            printf 'applied %s: down=%smbit up=%smbit\n' "$iface" "$dl" "$ul"
        done
    } || _rc=$?
    return $_rc
}

# ---------------------------------------------------------------------------
# systemd service
# ---------------------------------------------------------------------------

install_service() {
    _force=$1
    _template="$ALABOFUR_SHAREDIR/alabofur.service"
    [ -f "$_template" ] || die "service template not found: $_template"

    if [ -e "$SERVICE_INSTALL_PATH" ] && [ "$_force" != "1" ]; then
        die "$SERVICE_INSTALL_PATH already exists (use --force to overwrite)"
    fi

    _bin=$(command -v alabofur 2>/dev/null || echo "$_self")
    sed "s#@ALABOFUR_BIN@#$_bin#g" "$_template" > "$SERVICE_INSTALL_PATH"
    runq systemctl daemon-reload
    runq systemctl enable alabofur.service
}

systemctl_action() {
    _action=$1
    if ! have systemctl; then
        err "systemctl not found; systemd is required for service management."
        return 1
    fi
    systemctl "$_action" alabofur.service
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

cmd_list() {
    check_conf_readable || return 1
    _configs=$(load_all_configs 2>/dev/null) || _configs=""

    if [ "$#" -eq 0 ]; then
        set --
        if [ -n "$_configs" ]; then
            for _i in $(printf '%s\n' "$_configs" | awk -F "$TAB" '{print $1}'); do
                set -- "$@" "$_i"
            done
        fi
    fi

    if [ "$#" -eq 0 ]; then
        err "No interfaces configured; use \`alabofur add <iface> <down> <up>\`."
        return 1
    fi

    for _iface in "$@"; do
        _rec=$(printf '%s\n' "$_configs" | awk -F "$TAB" -v w="$_iface" '$1==w{print; exit}')
        if [ -n "$_rec" ]; then
            _dl=$(printf '%s' "$_rec" | cut -f2)
            _ul=$(printf '%s' "$_rec" | cut -f3)
            _v6=$(printf '%s' "$_rec" | cut -f4)
            printf '[%s] configured: down=%smbit up=%smbit ipv6=%s\n' "$_iface" "$_dl" "$_ul" "$_v6"
        else
            printf '[%s] not in config; showing tc state\n' "$_iface"
        fi
        tc_show "$_iface" || err "$_iface: error reading tc state"
    done
}

cmd_apply() {
    require_root
    install_dependencies || return 1
    apply_interfaces "$@"
}

cmd_add() {
    require_root
    _iface=""; _dl=""; _ul=""; _ipv6="true"
    for _a in "$@"; do
        case "$_a" in
            --ipv4-only) _ipv6="false" ;;
            *)
                if   [ -z "$_iface" ]; then _iface="$_a"
                elif [ -z "$_dl" ];    then _dl="$_a"
                elif [ -z "$_ul" ];    then _ul="$_a"
                fi
                ;;
        esac
    done
    if [ -z "$_iface" ] || [ -z "$_dl" ] || [ -z "$_ul" ]; then
        die "usage: $PROG add <interface> <download_mbit> <upload_mbit> [--ipv4-only]"
    fi
    ensure_iface "$_iface"
    case "$_dl$_ul" in *[!0-9]*) die "download and upload must be integers (mbit)";; esac

    install_dependencies || return 1
    save_interface_config "$_iface" "$_dl" "$_ul" "$_ipv6" >/dev/null
    printf 'saved config %s at %s\n' "$_iface" "$CONF_DIR"
    apply_interfaces "$_iface"
}

cmd_deny() {
    require_root
    _iface=${1:-}
    [ -n "$_iface" ] || die "usage: $PROG deny <interface>"
    ensure_iface "$_iface"
    install_dependencies || return 1
    save_interface_config "$_iface" 1 1 true >/dev/null
    printf 'set %s to minimal bandwidth (deny)\n' "$_iface"
    apply_interfaces "$_iface"
}

cmd_clear() {
    require_root
    _iface=${1:-}
    [ -n "$_iface" ] || die "usage: $PROG clear <interface>"
    ensure_iface "$_iface"
    install_dependencies || return 1
    tc_clear "$_iface"
    printf 'cleared shaping for %s\n' "$_iface"
}

cmd_configtest() {
    if configtest; then
        printf 'config OK\n'
        return 0
    fi
    return 1
}

cmd_install_service() {
    _force=0
    for _a in "$@"; do
        [ "$_a" = "--force" ] && _force=1
    done
    require_root
    install_dependencies || return 1
    install_service "$_force"
    printf 'installed %s\n' "$SERVICE_INSTALL_PATH"
}

cmd_remove_service() {
    require_root
    if [ -e "$SERVICE_INSTALL_PATH" ]; then
        runq systemctl disable alabofur.service
        rm -f "$SERVICE_INSTALL_PATH"
        runq systemctl daemon-reload
        printf 'service removed\n'
    else
        printf 'service not installed\n'
    fi
}

cmd_service_run() {
    # entry point invoked by the systemd unit
    configtest || return 1
    apply_interfaces "$@"
}

# ---------------------------------------------------------------------------
# terminal output
# ---------------------------------------------------------------------------

# utf8_locale
# Test whether the current locale uses UTF-8 (needed for block characters).
utf8_locale() {
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) return 0 ;;
    esac
    return 1
}

# set_color_mode
# Set COLOR_MODE for stdout: 24 when COLORTERM advertises 24-bit colour, else
# 256; none for pipes, TERM=dumb or when NO_COLOR is set.
set_color_mode() {
    COLOR_MODE=256
    case "${COLORTERM:-}" in truecolor|24bit) COLOR_MODE=24 ;; esac
    if [ ! -t 1 ] || [ "${TERM:-dumb}" = "dumb" ] || [ -n "${NO_COLOR:-}" ]; then
        COLOR_MODE=none
    fi
}

# banner
# Print the ALABOFUR logo shown above the help text, followed by the live
# rate of every interface (sampled over one second). Only drawn on a UTF-8
# terminal, so pipes, scripts and plain consoles get the bare usage.
# NO_COLOR keeps the logo but drops the colours.
banner() {
    [ -t 1 ] || return 0
    [ "${TERM:-dumb}" != "dumb" ] || return 0
    utf8_locale || return 0
    set_color_mode

    awk -v mode="$COLOR_MODE" '
        function color(c) {
            if (mode == "none") return ""
            return (mode == "24") ? "\033[38;2;" c "m" : "\033[38;5;" c "m"
        }
        BEGIN {
            # per-row block face and shadow colours, top to bottom
            if (mode == "24") {
                split("37;217;255 48;202;255 59;186;255 69;171;255 80;155;255 91;140;255", face, " ")
                split("15;87;102 19;81;102 24;74;102 28;68;102 32;62;102 36;56;102", shade, " ")
                rule = "64;179;255"
            } else {
                split("45 45 75 75 69 69", face, " ")
                split("23 23 24 24 17 17", shade, " ")
                rule = "75"
            }
            reset = (mode == "none") ? "" : "\033[0m"
            width = 73
        }
        {
            line = $0
            gsub(/(█)+/, color(face[NR]) "&", line)
            gsub(/(╗|╔|═|╝|║|╚)+/, color(shade[NR]) "&", line)
            printf("%s%s\n", line, reset)
        }
        END {
            printf("%s", color(rule))
            for (i = 0; i < width; i++) printf("=")
            printf("%s\n", reset)

            # letter-spaced tagline, centred, with a cyan-to-blue gradient
            t = "s i m p l e   b a n d w i d t h   s h a p e r"
            n = length(t)
            for (i = int((width - n) / 2); i > 0; i--) printf(" ")
            for (i = 1; i <= n; i++) {
                ch = substr(t, i, 1)
                k = (i - 1) / (n - 1)
                if (ch == " ")
                    c = ""
                else if (mode == "24")
                    c = color(int(37 + 54 * k) ";" int(217 - 77 * k) ";255")
                else
                    c = color(face[1 + int(k * 5)])
                printf("%s%s", c, ch)
            }
            printf("%s\n\n", reset)
        }
    ' <<'EOF'
 █████╗  ██╗       █████╗  ██████╗   ██████╗  ███████╗ ██╗   ██╗ ██████╗
██╔══██╗ ██║      ██╔══██╗ ██╔══██╗ ██╔═══██╗ ██╔════╝ ██║   ██║ ██╔══██╗
███████║ ██║      ███████║ ██████╔╝ ██║   ██║ █████╗   ██║   ██║ ██████╔╝
██╔══██║ ██║      ██╔══██║ ██╔══██╗ ██║   ██║ ██╔══╝   ██║   ██║ ██╔══██╗
██║  ██║ ███████╗ ██║  ██║ ██████╔╝ ╚██████╔╝ ██║      ╚██████╔╝ ██║  ██║
╚═╝  ╚═╝ ╚══════╝ ╚═╝  ╚═╝ ╚═════╝   ╚═════╝  ╚═╝       ╚═════╝  ╚═╝  ╚═╝
EOF

    _a=$(stats_snapshot 0)
    sleep 1
    _b=$(stats_snapshot 0)
    { printf '%s\n%s\n' "$_a" "$_b"; stats_limits; } | stats_render banner "$COLOR_MODE" 1
}

# ---------------------------------------------------------------------------
# live traffic view
# ---------------------------------------------------------------------------

# top_restore
# Undo the terminal changes made by cmd_top (EXIT trap).
top_restore() {
    [ -n "${_top_stty:-}" ] && stty "$_top_stty" 2>/dev/null
    printf '\033[?25h\033[?1049l'
}

# cmd_top [IFACE...]
# Redraw interface rates, shaping usage and the busiest processes every
# second until q or Ctrl-C. Without a terminal it prints one sample and exits.
cmd_top() {
    ensure_binary ss
    ensure_binary tc
    for _i in "$@"; do
        ensure_iface "$_i"
        [ -d "/sys/class/net/$_i" ] || die "No such interface: $_i"
    done
    set_color_mode
    _utf=0
    utf8_locale && _utf=1
    _limits=$(stats_limits)

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        _a=$(stats_snapshot 1 "$@")
        sleep 1
        _b=$(stats_snapshot 1 "$@")
        printf '%s\n%s\n%s\n' "$_a" "$_b" "$_limits" | stats_render top "$COLOR_MODE" "$_utf"
        return
    fi

    # Raw-ish input: reading one key waits at most 1s, which also paces the
    # refresh. Draw on the alternate screen so the shell is left untouched.
    _top_stty=$(stty -g)
    trap top_restore EXIT
    trap 'exit 130' INT TERM
    stty -icanon -echo min 0 time 10
    printf '\033[?1049h\033[?25l\033[H\033[2Jmeasuring...\n'
    _a=$(stats_snapshot 1 "$@")
    while :; do
        _k=$(dd bs=1 count=1 2>/dev/null)
        case "$_k" in q|Q) break ;; esac
        _b=$(stats_snapshot 1 "$@")
        printf '\033[H'
        printf '%s\n%s\n%s\n' "$_a" "$_b" "$_limits" | \
            stats_render top "$COLOR_MODE" "$_utf" "$(printf '\033[K')"
        printf '\033[J'
        _a=$_b
    done
}

usage() {
    cat <<EOF
$PROG $VERSION - simple bandwidth shaper

Usage: $PROG <command> [args]

Commands:
  list [iface...]                 show current tc state for configured interfaces
  top [iface...]                  live traffic per interface and process (q to quit)
  apply [iface...]                apply limits from config (default: all)
  add <iface> <down> <up> [--ipv4-only]
                                  add/update interface limits (mbit) and apply
  deny <iface>                    set interface to near-zero bandwidth (1/1 mbit)
  clear <iface>                   remove shaping rules for interface
  configtest                      validate configuration files
  install-service [--force]       install systemd service
  remove-service                  remove systemd service
  start|stop|restart|status       manage the systemd service
  --version                       print version
  -h, --help                      show this help

Config: $DEFAULT_CONF_FILE plus $CONF_DIR/*.conf
EOF
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

main() {
    [ "$#" -ge 1 ] || { banner >&2; usage >&2; exit 2; }
    _cmd=$1; shift
    case "$_cmd" in
        list)            cmd_list "$@" ;;
        top)             cmd_top "$@" ;;
        apply)           cmd_apply "$@" ;;
        add)             cmd_add "$@" ;;
        deny)            cmd_deny "$@" ;;
        clear)           cmd_clear "$@" ;;
        configtest)      cmd_configtest "$@" ;;
        install-service) cmd_install_service "$@" ;;
        remove-service)  cmd_remove_service "$@" ;;
        start)           require_root; systemctl_action start ;;
        stop)            require_root; systemctl_action stop ;;
        restart)         require_root; systemctl_action restart ;;
        status)          require_root; systemctl_action status ;;
        service-run)     cmd_service_run "$@" ;;
        --version|-V|version) printf '%s %s\n' "$PROG" "$VERSION" ;;
        -h|--help|help)  banner; usage ;;
        *)               err "unknown command: $_cmd"; usage >&2; exit 2 ;;
    esac
}

main "$@"
